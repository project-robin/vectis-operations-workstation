{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "convex/schema.ts",
      "convex/auth.config.ts",
      "convex/convex.config.ts",
      "convex/http.ts",
      "convex/crons.ts",
      "convex/toolchain.ts",
      "convex/toolchain.test.ts",
      "convex/nodeActions.ts",
      "middleware.ts",
      "next.config.ts",
      "playwright.config.ts",
      "package.json",
      "tsconfig.json",
      "vitest.config.ts",
      "convex.json",
      "scripts/**",
      "test/components/**",
      "test/e2e/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
