{
  "name": "vectis-operations-workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "start:server": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "csv-parse": "^7.0.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "jsdom": "27.4.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
