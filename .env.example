# Workstation PostgreSQL connection
DATABASE_URL=postgres://vectis:change-me@127.0.0.1:55432/vectis_workstation
DOGRAH_WEBHOOK_SECRET=replace-with-a-long-random-secret

# API listener. Non-loopback binding requires WORKSTATION_API_KEY.
HOST=127.0.0.1
PORT=4100
WORKSTATION_API_KEY=

# Browser tenant context. Use the same organization UUID provisioned in PostgreSQL.
VITE_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# External providers
DOGRAH_API_URL=http://127.0.0.1:8000
DOGRAH_API_KEY=
MANAGER_API_KEY=
TWENTY_MCP_URL=https://your-workspace.twenty.com/mcp
TWENTY_MCP_API_KEY=
OUTBOX_POLL_MS=5000
