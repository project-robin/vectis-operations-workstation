# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Svix/Standard Webhooks secret for the Convex Clerk lifecycle endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=
# Issuer domain configured in the Convex deployment environment (convex/auth.config.ts)
CLERK_ISSUER_DOMAIN=

# Clerk hosted pages -> the app's own branded pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CONVEX_SITE_URL=

# Calling console (read by scripts/setup-dograh-agents.mjs, which copies them into
# the Convex deployment env; the Convex functions only read the Convex env).
DOGRAH_API_URL=https://api.dograh.com
DOGRAH_API_KEY=
# Twenty CRM: Settings -> APIs & Webhooks -> create a long-lived API key.
TWENTY_API_URL=https://api.twenty.com
TWENTY_API_KEY=
# Set by the setup script in the Convex env (not needed locally):
# DOGRAH_LEAD_WORKFLOW_ID, DOGRAH_QUICK_CALL_WORKFLOW_ID, DOGRAH_QUICK_CALL_TRIGGER_PATH, VECTIS_DOGRAH_WEBHOOK_SECRET

# Legacy draft integrations (Tasks 6-8)
DOGRAH_WEBHOOK_SECRET=replace-with-a-long-random-secret
TWENTY_MCP_URL=https://your-workspace.twenty.com/mcp
TWENTY_MCP_API_KEY=

# Hermes manager
HERMES_MANAGER_KEY=

# Task 3 protected verification (all values are required together; use a disposable tenant only)
TASK3_PROTECTED_DISPOSABLE_TENANT=0
TASK3_PROTECTED_FIXTURE_ORGANIZATION_ID=
TASK3_PROTECTED_CROSS_TENANT_ORGANIZATION_ID=
TASK3_PROTECTED_OWNER_CLERK_ID=
TASK3_PROTECTED_OPERATOR_CLERK_ID=
TASK3_PROTECTED_STAFF_CLERK_ID=
TASK3_PROTECTED_OWNER_ROLE=owner
TASK3_PROTECTED_OPERATOR_ROLE=operator
TASK3_PROTECTED_STAFF_ROLE=staff
TASK3_PROTECTED_OWNER_STORAGE_STATE=
TASK3_PROTECTED_OPERATOR_STORAGE_STATE=
TASK3_PROTECTED_STAFF_STORAGE_STATE=
TASK3_PROTECTED_CROSS_TENANT_STORAGE_STATE=
